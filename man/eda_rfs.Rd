eda_rfs(M1,q =TRUE)

M2 <- eda_lm(mtcars, mpg, hp)
eda_rfs(M2,q =TRUE)

M3 <- eda_rline(mtcars, mpg, hp)
eda_rfs(M3, q =TRUE)

